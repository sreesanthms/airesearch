{
  "AWSEBDockerrunVersion": "2",
  "containerDefinitions": [
    {
      "name": "researchpilot-backend",
      "image": "researchpilot-backend",
      "essential": true,
      "memory": 1024,
      "portMappings": [
        {
          "hostPort": 8000,
          "containerPort": 8000
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "upload-data",
          "containerPath": "/app/uploads"
        },
        {
          "sourceVolume": "faiss-data",
          "containerPath": "/app/storage/faiss"
        }
      ]
    },
    {
      "name": "researchpilot-frontend",
      "image": "researchpilot-frontend",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 80
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "upload-data",
      "host": {
        "path": "/var/app/current/uploads"
      }
    },
    {
      "name": "faiss-data",
      "host": {
        "path": "/var/app/current/storage/faiss"
      }
    }
  ]
}
