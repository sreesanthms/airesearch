# ─────────────────────────────────────────────────────────────────────────────
# ResearchPilot Production Environment Variables Template
# Use this file to configure environment settings on AWS Elastic Beanstalk
# ─────────────────────────────────────────────────────────────────────────────

# Application Core Configuration
APP_ENV=production                             # Environment mode (production, staging, development)
APP_NAME=ResearchPilot                          # Application display name
APP_VERSION=1.0.0                              # Release semantic version
APP_LOG_LEVEL=INFO                             # Logging verbosity (DEBUG, INFO, WARNING, ERROR)
PYTHONUNBUFFERED=1                             # Enforce unbuffered Python log output for CloudWatch

# Backend Networking & CORS Settings
BACKEND_HOST=0.0.0.0                           # Network binding interface
BACKEND_PORT=8000                              # Target container listening port (maps to PORT)
PORT=8000                                      # Elastic Beanstalk assigned target port
BACKEND_WORKERS=1                              # Uvicorn worker process count
BACKEND_CORS_ORIGINS=http://localhost:5173     # Allowed CORS origins (comma-separated list for production domains)

# Frontend Integration
VITE_API_BASE_URL=http://localhost:8000/api/v1  # Base URL for frontend API requests
VITE_APP_TITLE=ResearchPilot                   # Browser tab title

# Google Gemini LLM API (SECRET)
# Set your Google AI Studio key via Elastic Beanstalk Environment Properties or AWS Secrets Manager
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-latest           # Active Gemini model candidate
GEMINI_REQUEST_TIMEOUT_SECONDS=30               # Maximum timeout for model stream response
GEMINI_MAX_RETRIES=3                           # Number of retries on transient quota/rate errors

# Vector RAG & FAISS Storage
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2           # SentenceTransformer model name
RAG_CHUNK_SIZE=500                             # Document chunk text character length
RAG_CHUNK_OVERLAP=100                          # Sliding window chunk overlap characters
RAG_TOP_K=5                                    # Number of nearest-neighbor chunks retrieved from FAISS
RAG_SIMILARITY_THRESHOLD=0.3                   # Minimum similarity threshold score

# File Upload Constraints
UPLOAD_MAX_SIZE_MB=25                          # Maximum PDF upload payload limit in MB
UPLOAD_ALLOWED_TYPES=application/pdf           # Allowed MIME content types
